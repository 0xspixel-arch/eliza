# Plugin Configuration Template
# Copy this to .env and fill in your actual values

# ==============================================
# CORE MODEL PROVIDER CONFIGURATION
# ==============================================

# OpenAI Configuration (for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenRouter Configuration (alternative model provider)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ==============================================
# BLOCKCHAIN CONFIGURATION
# ==============================================

# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Alternative RPC endpoints:
# SOLANA_RPC_URL=https://solana-api.projectserum.com
# SOLANA_RPC_URL=https://rpc.ankr.com/solana

# Solana Wallet Configuration (Base58 encoded private key)
WALLET_SECRET_KEY=your-base58-private-key-here

# Solana Network (mainnet-beta, devnet, testnet)
SOLANA_NETWORK=mainnet-beta

# ==============================================
# PLUGIN ENABLE/DISABLE FLAGS
# ==============================================

# Trust Plugin Configuration
ENABLE_TRUST_PLUGIN=true

# Web Search Plugin Configuration
ENABLE_WEB_SEARCH_PLUGIN=true

# Knowledge Plugin Configuration
ENABLE_KNOWLEDGE_PLUGIN=true

# Memory Plugin Configuration
ENABLE_MEMORY_PLUGIN=true

# Autonomous Plugin Configuration
ENABLE_AUTONOMOUS_PLUGIN=true

# ==============================================
# CLOUD SERVICES CONFIGURATION
# ==============================================

# ElizaCloud Configuration (for state synchronization)
ELIZACLOUD_API_KEY=your-elizacloud-api-key-here

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# PostgreSQL Configuration (if using external database)
# DATABASE_URL=postgresql://user:password@localhost:5432/eliza

# SQLite Configuration (default)
# DATABASE_FILE=./data/eliza.db

# ==============================================
# SERVER CONFIGURATION
# ==============================================

# Server Port
SERVER_PORT=3000

# CORS Configuration
CORS_ORIGIN=*

# API Configuration
API_CORS_ORIGIN=http://localhost:5173

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Secret (for authentication)
# JWT_SECRET=your-jwt-secret-here

# API Key (for external API access)
# API_KEY=your-api-key-here

# ==============================================
# TRUST PLUGIN CONFIGURATION
# ==============================================

# Risk Threshold (0.0 to 1.0, lower = more conservative)
TRUST_RISK_THRESHOLD=0.3

# Trust Data Source (local, external, hybrid)
TRUST_DATA_SOURCE=hybrid

# ==============================================
# AUTONOMOUS PLUGIN CONFIGURATION
# ==============================================

# Maximum Concurrent Autonomous Tasks
MAX_CONCURRENT_TASKS=5

# Task Execution Interval (seconds)
TASK_CHECK_INTERVAL=60

# ==============================================
# KNOWLEDGE PLUGIN CONFIGURATION
# ==============================================

# Vector Store Type (pgvector, pinecone, weaviate)
VECTOR_STORE=pgvector

# Knowledge Base Update Interval (hours)
KNOWLEDGE_UPDATE_INTERVAL=24

# ==============================================
# MEMORY PLUGIN CONFIGURATION
# ==============================================

# Memory Persistence Type (database, file, hybrid)
MEMORY_PERSISTENCE=database

# Memory Cleanup Interval (hours)
MEMORY_CLEANUP_INTERVAL=168

# ==============================================
# WEB SEARCH PLUGIN CONFIGURATION
# ==============================================

# Search Provider (google, bing, duckduckgo, serper)
SEARCH_PROVIDER=serper

# Search API Key
SEARCH_API_KEY=your-search-api-key-here

# Maximum Search Results
MAX_SEARCH_RESULTS=10

# ==============================================
# DEVELOPMENT CONFIGURATION
# ==============================================

# Debug Mode
DEBUG=false

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Development Features
ENABLE_DEV_FEATURES=false